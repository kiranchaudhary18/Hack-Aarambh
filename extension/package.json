{
  "name": "scamsniff-extension",
  "displayName": "ScamSniff Extension",
  "version": "1.1.0",
  "description": "Browser extension for detecting scams in images using AI",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build --target=chrome-mv3 && plasmo build --target=firefox-mv3",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.0",
    "lucide-react": "^1.18.0",
    "plasmo": "^0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@parcel/watcher": "2.4.1"
  },
  "manifest": {
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "sidePanel",
      "tabs"
    ],
    "host_permissions": [
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "scamsniff-extension@example.com",
        "strict_min_version": "109.0"
      }
    },
    "sidebar_action": {
      "default_panel": "sidepanel.html"
    }
  }
}
