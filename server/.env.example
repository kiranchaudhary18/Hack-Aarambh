# Database Configuration Key
DATABASE_URL=your-database-connection-string
# JWT Secret Key
JWT_SECRET=your-secret-key

# Email Service Configuration
# Set to true for development/testing (uses Ethereal Email)
# Set to false for production (uses configured SMTP)
USE_ETHEREAL=true

# SMTP Configuration for Email Service (used when USE_ETHEREAL=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ScamSniff <noreply@scamsniff.com>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
FRONTEND_URL=website-url