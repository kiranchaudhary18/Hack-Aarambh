generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String                    @unique @db.VarChar
  password                String                    @db.VarChar
  role                    String                    @default("user") @db.VarChar
  name                    String?                   @db.VarChar
  avatar                  String?                   @db.VarChar
  scansUsed               Int                       @default(0)
  scansLimit              Int                       @default(20)
  plan                    String                    @default("free") @db.VarChar
  isVerified              Boolean                   @default(false)
  twoFactorSecret         String?                   @db.VarChar
  twoFactorEnabled        Boolean                   @default(false)
  twoFactorBackupCodes    Json?                     @default("[]")
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamp(6)
  apiTokens               ApiToken[]
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  histories               History[]
  extensionSettings       ExtensionSettings[]
  extensionScans          ExtensionScan[]
  extensionNotifications  ExtensionNotification[]

  @@map("user")
}

model History {
  id           String    @id @default(uuid()) @db.Uuid
  input        String    @db.VarChar
  result       String?   @db.VarChar
  userId       String?   @db.Uuid
  status       String    @default("pending") @db.VarChar
  processedAt  DateTime? @db.Timestamp(6)
  pdfUrl       String?   @db.VarChar
  imageUrl     String?   @db.VarChar
  analysisType String    @default("text") @db.VarChar
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  source       String?   @default("web") @db.VarChar
  user         User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("history")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  code      String   @unique @db.VarChar
  expiresAt DateTime @db.Timestamp(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("password_reset")
}

model ApiToken {
  id            String   @id @default(uuid()) @db.Uuid
  token         String   @unique @db.VarChar
  userId        String   @db.Uuid
  name          String?  @db.VarChar
  dailyLimit    Int      @default(50)
  usageCount    Int      @default(0)
  lastResetDate DateTime @default(now()) @db.Timestamp(6)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("api_token")
}

model EmailUpdateVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.VarChar
  newEmail  String   @db.VarChar
  token     String   @unique @db.VarChar
  expiresAt DateTime @db.Timestamp(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@map("email_update_verification")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar
  expiresAt DateTime @db.Timestamp(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("email_verification")
}

model ExtensionSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  settings  Json?
  isActive  Boolean  @default(true)
  deviceInfo Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("extension_settings")
}

model ExtensionScan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  url       String   @db.VarChar
  scanType  String   @db.VarChar
  result    Json?
  pageTitle String?  @db.VarChar
  domain    String?  @db.VarChar
  isScam    Boolean  @default(false)
  reported  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("extension_scan")
}

model ExtensionNotification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  type       String   @db.VarChar
  title      String   @db.VarChar
  message    String   @db.Text
  data       Json?
  status     String   @default("pending") @db.VarChar
  read       Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  deliveredAt DateTime? @db.Timestamp(6)
  readAt     DateTime? @db.Timestamp(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("extension_notification")
}

model ScamDatabase {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @db.VarChar
  domain        String?  @db.VarChar
  scamType      String   @db.VarChar
  severity      String   @default("medium") @db.VarChar
  description   String   @db.Text
  sources       Json     @default("[]")
  reportCount   Int      @default(0)
  isVerified    Boolean  @default(false)
  isExternal    Boolean  @default(false)
  externalSource String?  @db.VarChar
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  @@index([companyName])
  @@index([domain])
  @@index([scamType])
  @@map("scam_database")
}
